+package com.example.ui.screens
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class BrowserAddressInputTest {
+    @Test fun blankDoesNotNavigate() {
+        assertNull(normalizeBrowserInput("  ", BrowserSearchProvider.GOOGLE))
+    }
+    @Test fun webAddressesKeepTheirOriginalScheme() {
+        assertEquals("HTTP://Example.com/A", normalizeBrowserInput("  HTTP://Example.com/A  ", BrowserSearchProvider.BING))
+        assertEquals("https://example.com/a?q=x", normalizeBrowserInput("example.com/a?q=x", BrowserSearchProvider.GOOGLE))
+    }
+    @Test fun searchesUseSelectedProviderAndEncodeInput() {
+        assertEquals("https://www.google.com/search?q=hello+world", normalizeBrowserInput("hello world", BrowserSearchProvider.GOOGLE))
+        assertEquals("https://www.bing.com/search?q=hello+world", normalizeBrowserInput("hello world", BrowserSearchProvider.BING))
+        assertEquals("https://duckduckgo.com/?q=hello+world", normalizeBrowserInput("hello world", BrowserSearchProvider.DUCKDUCKGO))
+        assertEquals("https://www.google.com/search?q=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7+%26+%E2%99%AB", normalizeBrowserInput("مرحبا & ♫", BrowserSearchProvider.GOOGLE))
+    }
+}
