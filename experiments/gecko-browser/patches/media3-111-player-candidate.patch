--- /dev/null
+++ b/app/src/test/java/com/example/playback/OptimizedPlayerBuilderFlagsTest.kt
@@ -0,0 +1,19 @@
+package com.example.playback
+
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.extractor.DefaultExtractorsFactory
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/** Guard the old 1.5.1 behavior without accidentally enabling newer flags. */
+@UnstableApi
+class OptimizedPlayerBuilderFlagsTest {
+    @Test fun mp4FlagsUseOnlyPreviouslyEnabledBits() {
+        val method = OptimizedPlayerBuilder::class.java.getDeclaredMethod("extractorsFactory")
+        method.isAccessible = true
+        val factory = method.invoke(OptimizedPlayerBuilder) as DefaultExtractorsFactory
+        val field = DefaultExtractorsFactory::class.java.getDeclaredField("mp4Flags")
+        field.isAccessible = true
+        assertEquals(0x7d, field.getInt(factory))
+    }
+}
