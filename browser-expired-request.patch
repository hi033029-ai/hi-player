From 873e14ee8b82f20fee7fd109b2bc1902a3e77a2f Mon Sep 17 00:00:00 2001
From: Hi Player contributor <contributor@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:51:05 +0000
Subject: [PATCH] Handle expired browser links without modifying XML

---
 app/src/main/assets/orbit_adblock.js          |  2 +
 app/src/main/assets/orbit_page_skipper.js     |  2 +
 .../com/example/ui/screens/HiBrowserScreen.kt | 37 ++++++++++++++++---
 3 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/app/src/main/assets/orbit_adblock.js b/app/src/main/assets/orbit_adblock.js
index 76400f7..77a0af8 100644
--- a/app/src/main/assets/orbit_adblock.js
+++ b/app/src/main/assets/orbit_adblock.js
@@ -4,6 +4,8 @@
 // It never reads page data and never sends anything anywhere.
 (function () {
   'use strict';
+  // These page helpers must not alter XML, SVG, or server error documents.
+  if (document.contentType && document.contentType.toLowerCase() !== 'text/html') return;
   if (window.__hiAdShieldV1) return;
   window.__hiAdShieldV1 = true;
   var host = (location.hostname || '').toLowerCase();
diff --git a/app/src/main/assets/orbit_page_skipper.js b/app/src/main/assets/orbit_page_skipper.js
index 085fcb3..873a30a 100644
--- a/app/src/main/assets/orbit_page_skipper.js
+++ b/app/src/main/assets/orbit_page_skipper.js
@@ -9,6 +9,8 @@
 // ==/UserScript==
 (function () {
   'use strict';
+  // These page helpers must not alter XML, SVG, or server error documents.
+  if (document.contentType && document.contentType.toLowerCase() !== 'text/html') return;
   if (window.top !== window || window.__orbitSkipper) return;
   window.__orbitSkipper = true;
 
diff --git a/app/src/main/java/com/example/ui/screens/HiBrowserScreen.kt b/app/src/main/java/com/example/ui/screens/HiBrowserScreen.kt
index 5fd284c..10ff0dd 100644
--- a/app/src/main/java/com/example/ui/screens/HiBrowserScreen.kt
+++ b/app/src/main/java/com/example/ui/screens/HiBrowserScreen.kt
@@ -300,7 +300,18 @@ private fun hiBrowserInitialState(store: OrbitBrowserStore): HiBrowserInitialSta
 }
 
 /** A page that could not load because of the network (shown instead of WebView's error page). */
-private data class HiBrowserPageError(val tabId: Int, val url: String, val offline: Boolean)
+private data class HiBrowserPageError(val tabId: Int, val url: String, val offline: Boolean, val expiredLink: Boolean = false)
+
+// Only recognize the specific XML error returned for an expired signed link.
+private const val HI_BROWSER_EXPIRED_LINK_SCRIPT = """
+    (function() {
+        var type = (document.contentType || '').toLowerCase();
+        var root = document.documentElement;
+        if (!/(?:^|[+\/])xml$/.test(type) || !root || root.localName !== 'Error') return false;
+        var codes = root.getElementsByTagName('Code');
+        return codes.length > 0 && codes[0].textContent.trim() === 'ExpiredRequest';
+    })();
+"""
 
 private data class HiBrowserSecureRequest(val url: String, val fromPrivateTab: Boolean, val forSignIn: Boolean, val tabId: Int)
 
@@ -797,7 +808,7 @@ fun HiBrowserScreen(
         if (BrowserAdvancedRules.paused(Uri.parse(url).host)) return
         val css = OrbitBrowserFilterEngine.cosmeticCss(runCatching { Uri.parse(url).host }.getOrNull(), adBlockFlag.enabled)
         if (css.isNotBlank()) view.evaluateJavascript(
-            "(function(){var s=document.getElementById('__orbit_filter_css');if(!s){s=document.createElement('style');s.id='__orbit_filter_css';(document.head||document.documentElement).appendChild(s);}s.textContent=" + JSONObject.quote(css) + ";})();",
+            "(function(){if(document.contentType&&document.contentType.toLowerCase()!=='text/html')return;var s=document.getElementById('__orbit_filter_css');if(!s){s=document.createElement('style');s.id='__orbit_filter_css';(document.head||document.documentElement).appendChild(s);}s.textContent=" + JSONObject.quote(css) + ";})();",
             null,
         )
     }
@@ -1619,6 +1630,16 @@ fun HiBrowserScreen(
                                         recordHistory(view.title ?: url, url, redirectedFrom = redirectSources.remove(tabId))
                                     }
                                     injectCosmeticCss(view, url)
+                                    // Some hosts return an expired-link XML body even with a successful
+                                    // HTTP status. Do not expose the raw response or try to renew it.
+                                    view.evaluateJavascript(HI_BROWSER_EXPIRED_LINK_SCRIPT) { result ->
+                                        if (result == "true" && activeTabId == tabId && !showStartPage &&
+                                            view.url == url && tabs.firstOrNull { it.id == tabId }?.webView === view) {
+                                            pageError = HiBrowserPageError(tabId, url, offline = false, expiredLink = true)
+                                            pendingFirstPaint = false
+                                            pixelComet.cancel(); loadingProgress = 100
+                                        }
+                                    }
                                     if (!HiBrowserDocumentScripts.isSupported()) {
                                         if (store.adBlock) injectOrbitAsset(view, viewContext, "orbit_adblock.js")
                                         if (store.pageSkipper) injectOrbitAsset(view, viewContext, "orbit_page_skipper.js")
@@ -1684,7 +1705,9 @@ fun HiBrowserScreen(
             HiBrowserErrorPage(
                 url = visibleError.url,
                 offline = visibleError.offline || !networkOnline,
+                expiredLink = visibleError.expiredLink,
                 onRetry = { retryPage() },
+                onBack = { pageError = null; navigateBrowserBack() },
                 onHome = { showBrowserHome() },
                 modifier = Modifier.windowInsetsPadding(WindowInsets.navigationBars),
                 bottomInset = barHeightDp,
@@ -2674,7 +2697,9 @@ private fun HiBrowserLoadingPage(
 private fun HiBrowserErrorPage(
     url: String,
     offline: Boolean,
+    expiredLink: Boolean,
     onRetry: () -> Unit,
+    onBack: () -> Unit,
     onHome: () -> Unit,
     modifier: Modifier = Modifier,
     bottomInset: androidx.compose.ui.unit.Dp = 0.dp,
@@ -2701,7 +2726,7 @@ private fun HiBrowserErrorPage(
         )
         Spacer(Modifier.height(16.dp))
         Text(
-            if (offline) "No internet connection" else "Can't reach this page",
+            if (expiredLink) "Link expired" else if (offline) "No internet connection" else "Can't reach this page",
             color = palette.textPrimary,
             fontSize = 19.sp,
             fontWeight = FontWeight.SemiBold,
@@ -2709,7 +2734,8 @@ private fun HiBrowserErrorPage(
         )
         Spacer(Modifier.height(8.dp))
         Text(
-            if (offline) "Check Wi-Fi or mobile data. The page reloads by itself when you're back online."
+            if (expiredLink) "Regenerate the link and try again."
+            else if (offline) "Check Wi-Fi or mobile data. The page reloads by itself when you're back online."
             else "This page is unavailable or couldn't be opened securely. Try again, check the address, or return Home.",
             color = palette.textSecondary,
             fontSize = 14.sp,
@@ -2717,7 +2743,8 @@ private fun HiBrowserErrorPage(
         )
         Spacer(Modifier.height(20.dp))
         Row(horizontalArrangement = Arrangement.spacedBy(12.dp), verticalAlignment = Alignment.CenterVertically) {
-            Button(onClick = onRetry) { Text("Retry") }
+            if (expiredLink) Button(onClick = onBack) { Text("Go back") }
+            else Button(onClick = onRetry) { Text("Retry") }
             TextButton(onClick = onHome) { Text("Home") }
         }
     }
-- 
