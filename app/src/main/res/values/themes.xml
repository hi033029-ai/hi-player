<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/hi_startup_background</item>
    </style>
    <style name="Theme.MyApplication.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hi_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
    <style name="Theme.HiBrowser.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:colorBackground">#121212</item>
    </style>
    <style name="Theme.HiBrowser.Light" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:colorBackground">#FFFFFF</item>
    </style>
</resources>
